# ===========================================
# RAILWAY DEPLOYMENT ENVIRONMENT VARIABLES
# ===========================================
# Copy these to Railway's Variables section

# Database (use internal URL in Railway for better performance)
# Railway auto-injects DATABASE_URL if you link a PostgreSQL service
DATABASE_URL=postgresql://postgres:PASSWORD@postgres.railway.internal:5432/railway

# JWT Authentication (IMPORTANT: Generate a secure secret for production!)
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING

# AI Services
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENAI_API_KEY=sk-proj-your-key-here

# S3 Storage (Railway S3-compatible bucket)
S3_ENDPOINT=https://storage.railway.app
S3_REGION=auto
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
MAX_FILE_SIZE=10485760

# Server
PORT=3000
NODE_ENV=production

# Frontend URL (update with your actual frontend URL)
FRONTEND_URL=https://your-frontend.vercel.app
CORS_ORIGIN=https://your-frontend.vercel.app
