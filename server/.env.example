# ===========================================
# RAILWAY DEPLOYMENT ENVIRONMENT VARIABLES
# ===========================================
# Copy these to Railway's Variables section

# Database (use internal URL in Railway for better performance)
# Railway auto-injects DATABASE_URL if you link a PostgreSQL service
DATABASE_URL=postgresql://postgres:PASSWORD@postgres.railway.internal:5432/railway

# JWT Authentication (IMPORTANT: Generate a secure secret for production!)
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING

# AI Services
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENAI_API_KEY=sk-proj-your-key-here

# File Storage (Railway volume mount path)
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=10485760

# Server
PORT=3000
NODE_ENV=production

# Frontend URL (update with your actual frontend URL)
FRONTEND_URL=https://your-frontend.vercel.app
CORS_ORIGIN=https://your-frontend.vercel.app
